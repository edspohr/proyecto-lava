{
  "version": 2,
  "builds": [
    {"src":"api/metrics.js","use":"@vercel/node"},
    {"src":"index.html","use":"@vercel/static"},
    {"src":"app.js","use":"@vercel/static"},
    {"src":"styles.css","use":"@vercel/static"},
    {"src":"favicon.svg","use":"@vercel/static"},
    {"src":"img/logo.png","use":"@vercel/static"}
  ],
  "routes": [
    {"src":"/api/metrics","dest":"/api/metrics.js"},
    {"src":"/","dest":"/index.html"},
    {"src":"/(index.html|app.js|styles.css|favicon.svg|img/logo.png)","dest":"/$1"},
    {"src":"/.*","status":404,"dest":"/404"}
  ]
}
